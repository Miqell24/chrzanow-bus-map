{
  "name": "chrzanow-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of the Chrzanów area bus network (ZKKM Chrzanów) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=6144 pipeline/build.mjs --all",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8187",
    "lines": "node pipeline/lines.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs"
  }
}
